# Copy this file to .env (same folder) and fill in your own keys. .env is git-ignored.
YT_API_KEY=
GEMINI_API_KEY=
# Model used for the story filter. The saved decisions in data/llm_judgments.csv came from this model,
# so keeping it means step 3 reuses them instead of sending all transcripts again.
GEMINI_MODEL=gemini-3.1-flash-lite
